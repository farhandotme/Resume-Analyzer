generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Resume {
  id         String   @id @default(uuid())
  pdf_url    String
  uploadedAt DateTime @default(now())

  analyses Analysis[]
}

model Analysis {
  id         String   @id @default(uuid())
  resumeId   String
  jobTitle   String
  atsScore   Int
  fullResult Json
  createdAt  DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  resumeId  String
  role      String
  content   String
  createdAt DateTime @default(now())
}
