# Copy this file to .env and fill in real values before deploying.
# (No PostgreSQL is used anywhere in this project — nothing to configure there.)

# ─── Domains / CORS ────────────────────────────────
# Public URL of the deployed frontend. Used by nginx and by the node
# backend's CORS allow-list. Add more, comma-separated, if you serve
# multiple domains (e.g. apex + www).
FRONTEND_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# ─── Authentication ────────────────────────────────
# Not currently read by any route in this codebase — kept as a reserved
# variable for when auth is added. Safe to leave as-is for now.
JWT_SECRET=your_jwt_secret

# ─── AI & Search ───────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key
TAVILY_API_KEY=your_tavily_api_key

# ─── Backend Services (internal, docker network) ───
FASTAPI_URL=http://fastapi:8000
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# ─── Frontend build-time vars (Vite) ───────────────
# Public URL the browser will call for the node API.
VITE_NODE_BACKEND_URL=https://your-domain.com/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ─── Email ──────────────────────────────────────────
# Not currently read by any route in this codebase — kept as a reserved
# variable. Safe to leave as-is for now.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
