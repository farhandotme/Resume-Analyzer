# Copy to .env (or .env.production) before building.

# Public URL of the node backend API, reached through nginx.
# In production this is usually just "/api" (same-origin, nginx proxies it).
VITE_NODE_BACKEND_URL=/api

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
