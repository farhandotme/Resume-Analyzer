# Copy this file to .env (for local dev) and fill in real values.
# In Docker builds these are passed as --build-arg instead (see Dockerfile),
# since Vite bakes VITE_* vars into the static bundle at build time.

# Base URL of the Node.js backend (app_backend), no trailing slash.
VITE_NODE_BACKEND_URL=http://localhost:3000

# Supabase project URL and public anon/publishable key, used client-side
# to upload resumes directly to Supabase Storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
